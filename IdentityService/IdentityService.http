@IdentityService_HostAddress = https://localhost:7220

### Login after verifying the email address
# @name login
POST {{IdentityService_HostAddress}}/api/identity/login
Content-Type: application/json

{
  "email": "new.user@example.com",
  "password": "Example-only long password 42!"
}

### Use the access token in Fitness Profile
GET https://localhost:7276/weatherforecast
Authorization: Bearer {{login.response.body.$.data.accessToken}}

### Register; use an address you control for an actual email.
POST {{IdentityService_HostAddress}}/api/identity/register
Content-Type: application/json

{
  "name": "Example User",
  "email": "new.user@example.com",
  "password": "Example-only long password 42!"
}

### Duplicate email, including different casing: 409
POST {{IdentityService_HostAddress}}/api/identity/register
Content-Type: application/json

{
  "name": "Example User",
  "email": "NEW.USER@example.com",
  "password": "Example-only long password 42!"
}

### Invalid inputs: 400
POST {{IdentityService_HostAddress}}/api/identity/register
Content-Type: application/json

{
  "name": "",
  "email": "invalid-email",
  "password": ""
}
