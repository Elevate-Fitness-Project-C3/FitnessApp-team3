@IdentityService_HostAddress = https://localhost:7220
@RefreshToken = paste-cookie-value-here
@PasswordResetOtp = paste-six-digit-code-from-email-here

### Login after verifying the email address
# @name login
POST {{IdentityService_HostAddress}}/api/identity/login
Content-Type: application/json

{
  "email": "new.user@example.com",
  "password": "Example-only long password 42!"
}

### Request a password reset for an address you control
POST {{IdentityService_HostAddress}}/api/identity/password-reset/request
Content-Type: application/json

{
  "email": "new.user@example.com"
}

### Verify the six-digit code from the email
# @name verifyPasswordReset
POST {{IdentityService_HostAddress}}/api/identity/password-reset/verify
Content-Type: application/json

{
  "email": "new.user@example.com",
  "otp": "{{PasswordResetOtp}}"
}

### Complete the reset using the token returned by verification
POST {{IdentityService_HostAddress}}/api/identity/password-reset/complete
Authorization: Bearer {{verifyPasswordReset.response.body.$.data.resetToken}}
Content-Type: application/json

{
  "newPassword": "Example-only new password 43!"
}

### Use the access token in Fitness Profile
GET https://localhost:7276/weatherforecast
Authorization: Bearer {{login.response.body.$.data.accessToken}}

### Refresh using the refresh_token value from the latest Set-Cookie header
# @name refresh
POST {{IdentityService_HostAddress}}/api/identity/refresh
Cookie: refresh_token={{RefreshToken}}

### Update RefreshToken with the replacement cookie before logging out
POST {{IdentityService_HostAddress}}/api/identity/logout
Cookie: refresh_token={{RefreshToken}}

### Register; use an address you control for an actual email.
POST {{IdentityService_HostAddress}}/api/identity/register
Content-Type: application/json

{
  "name": "Example User",
  "email": "new.user@example.com",
  "password": "Example-only long password 42!"
}

### Duplicate email, including different casing: 409
POST {{IdentityService_HostAddress}}/api/identity/register
Content-Type: application/json

{
  "name": "Example User",
  "email": "NEW.USER@example.com",
  "password": "Example-only long password 42!"
}

### Invalid inputs: 400
POST {{IdentityService_HostAddress}}/api/identity/register
Content-Type: application/json

{
  "name": "",
  "email": "invalid-email",
  "password": ""
}
