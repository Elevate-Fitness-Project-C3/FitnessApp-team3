# Copy to .env and replace these local development credentials before starting.
# SQL Server requires a strong password. Avoid semicolons in this password
# because it is also interpolated into application connection strings.
MSSQL_SA_PASSWORD=ReplaceWithYourOwnStrongPassword123!
RABBITMQ_USER=fitness
RABBITMQ_PASSWORD=ReplaceWithYourOwnRabbitPassword123!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_SENDER_NAME=FitnessApp
SMTP_SENDER_EMAIL=your-new-account@gmail.com
SMTP_USERNAME=your-new-account@gmail.com
SMTP_PASSWORD=<GMAIL_APP_PASSWORD>
OTP_PROTECTION_KEY=<BASE64_ENCODED_RANDOM_32_BYTE_SECRET>

# Local JWT key pair. Compose passes the private PEM only to IdentityService.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

JWT_ISSUER=FitnessApp.Identity
JWT_AUDIENCE=FitnessApp.Api
JWT_KEY_ID=fitness-1
